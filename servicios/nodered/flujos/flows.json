    {
        "id": "f-senales",
        "type": "function",
        "z": "flujo-panel",
        "name": "Señal -> valor",
        "func": "\nfunction hora(ts) {\n    if (!ts) return \"—\";\n    return new Date(ts).toLocaleString(\"es-ES\", {timeZone: \"Europe/Madrid\", day: \"2-digit\", month: \"2-digit\",\n        year: \"numeric\", hour: \"2-digit\", minute: \"2-digit\"});\n}\n\n// Cada señal llega como {\"type\":\"tag\",\"body\":{t, v, q, k, ts}}. Si la calidad o la coherencia\n// no son correctas, se indica junto al valor.\nconst b = msg.payload && msg.payload.body;\nif (!b) return null;\nconst nota = b.q === 1 ? \" (sin comunicación)\" : (b.k === 10 ? \"\" : (b.k !== 0 ? \" (dato dudoso, K = \" + b.k + \")\" : \"\"));\nconst salidas = [null, null, null, null, null, null, null];\nconst v = b.v;\nswitch (b.t) {\n    case \"PHONE1.BAT1.level\":\n        if (v === null) return null;\n        salidas[0] = {payload: Math.round(v)};\n        salidas[6] = {payload: {x: new Date(b.ts).getTime(), y: v}, topic: \"Nivel\"};\n        flow.set(\"instante\", b.ts);\n        break;\n    case \"PHONE1.status.plugged\":\n        salidas[1] = {payload: (v === 1 ? \"Enchufado\" : v === 0 ? \"Desenchufado\" : \"—\") + nota}; break;\n    case \"PHONE1.status.sleep\":\n        salidas[2] = {payload: (v === 1 ? \"Activado\" : v === 0 ? \"Desactivado\" : \"—\") + nota}; break;\n    case \"PHONE1.BAT1.temperature\":\n        salidas[3] = {payload: (v === null ? \"—\" : v.toFixed(1).replace(\".\", \",\") + \" °C\") + nota}; break;\n    case \"PHONE1.BAT1.soh\":\n        salidas[4] = {payload: (v === null ? \"—\" : v + \" %\") + nota}; break;\n    case \"CHARGER1.limit.command.feedback\":\n        salidas[5] = {payload: (v === null ? \"—\" : v + \" %\") + nota}; break;\n    default:\n        return null;\n}\nreturn salidas;\n",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 110,
        "wires": [
            [
                "w-nivel"
            ],
            [
                "w-enchufado"
            ],
            [
                "w-dormir"
            ],
            [
                "w-temp"
            ],
            [
                "w-salud"
            ],
            [
                "w-limite"
            ],
            [
                "w-grafica"
            ]
        ]
    },
