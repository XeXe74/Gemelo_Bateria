        "type": "ui-template",
        "z": "flujo-panel",
        "group": "g-decision",
        "page": "",
        "ui": "",
        "name": "Decisión",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div v-if=\"msg && msg.payload\" style=\"color:#1E3A5F\">\n    <div style=\"color:#2C7A7B;font-weight:600\">{{ msg.payload.titulo }} · para el {{ msg.payload.dia }}</div>\n    <div style=\"font-size:44px;font-weight:700;margin:4px 0\">{{ msg.payload.limite }} %</div>\n    <div>Corte estimado de la carga: <b>{{ msg.payload.corte }}</b> (al enchufar con un {{ msg.payload.nivel }} %)</div>\n    <div>Consumo previsto de mañana: <b>{{ msg.payload.consumo }} %</b></div>\n    <p style=\"margin-top:10px\">{{ msg.payload.explicacion }}</p>\n    <div style=\"font-size:12px;color:#8A94A3\">Modelo: {{ msg.payload.modelo }} · instante simulado: {{ msg.payload.instante }}</div>\n  </div>\n  <div v-else>Todavía no hay ninguna previsión. Se publica a partir de las 18:00 del día simulado.</div>\n</template>",
        "storeOutMessages": true,
        "passthru": false,
