# Copia este fichero como .env y cambia las contraseñas. El .env no se versiona.
# Las contraseñas no pueden llevar espacios ni dos puntos.

# Bus del activo
CLAVE_ACTIVO_SIMULADOR=cambiar
CLAVE_ACTIVO_CONECTOR=cambiar

# Bus del gemelo
CLAVE_GEMELO_CONECTOR=cambiar
CLAVE_GEMELO_DECISION=cambiar
CLAVE_GEMELO_TELEGRAF=cambiar
CLAVE_GEMELO_PANEL=cambiar

# Histórico (InfluxDB): contraseña del usuario «administrador» y token de acceso
INFLUX_CLAVE_ADMIN=cambiar
INFLUX_TOKEN=cambiar

# Panel: «administrador» entra en el editor de flujos y «lector» en el panel
PANEL_CLAVE_ADMIN=cambiar
PANEL_CLAVE_LECTOR=cambiar
PUERTO_PANEL=1880

# Simulación: año de uso (data/uso/uso_s<n>.xlsx), velocidad (1 = tiempo real, 2880 = un día cada
# 30 s), arranque en pausa (1) o en marcha (0) y semilla de la batería simulada
SEMILLA_USO=0
VELOCIDAD=2880
PAUSA_INICIAL=0
SEED_UNIDAD=1234
